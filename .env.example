 # Copy this file to .env and replace the placeholder values.

# Email settings for OTP delivery (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-gmail-app-password
EMAIL_TIMEOUT=20

STRIPE_SECRET_KEY=sk_test_replace_with_your_real_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_real_test_publishable_key
STRIPE_CURRENCY=npr
STRIPE_CHECKOUT_TTL_MINUTES=30
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_PAYMENT_URL=https://uat.esewa.com.np/epay/main
ESEWA_VERIFY_URL=https://uat.esewa.com.np/epay/transrec
ESEWA_CURRENCY=npr
